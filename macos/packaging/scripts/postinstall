#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
LABEL=com.ozzy.daemon
launchctl bootstrap system "/Library/LaunchDaemons/$LABEL.plist" \
	|| echo "Could not start $LABEL; it starts at the next boot."
# Give the daemon its handshake with a connected device (about a second) before coreaudiod starts
# again and the HAL looks for its devices
for _ in $(seq 50); do
	launchctl print "system/$LABEL" 2>/dev/null | grep -q 'state = running' && break
	sleep 0.1
done
sleep 2
# SIGTERM so coreaudiod shuts down in order (launchd starts it again on demand
# with the new plug-ins); SIGKILL only if it is still there after 5 s.
pid="$(pgrep -x coreaudiod || true)"
if [ -n "$pid" ]; then
	kill -TERM "$pid" 2>/dev/null || true
	for _ in $(seq 50); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.1
	done
	kill -KILL "$pid" 2>/dev/null || true
fi
killall MIDIServer 2>/dev/null || true
